# Copy this file to .env for local runs.
# In GitLab/AWS, configure these as environment variables instead.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.1-8b-instant
PDF_FOLDER=pdfs
FAISS_INDEX_PATH=faiss_index
EMBEDDING_CACHE_FOLDER=.cache/embeddings

# Optional retrieval tuning
CHUNK_SIZE=700
CHUNK_OVERLAP=150
KEYWORD_TOP_K=5
BM25_TOP_K=5
SEMANTIC_TOP_K=6
RERANK_TOP_K=3
MAX_CONTEXT_CHARS=2400
MIN_RERANK_SCORE=-5.0
